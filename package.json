{
  "name": "@theotherwillembotha/node-red-prometheus",
  "version": "0.4.4",
  "description": "Prometheus metrics provider plugin for node-red-plugincore.",
  "author": "Willem Botha (@theotherwillembotha)",
  "license": "ISC",
  "keywords": [
    "node-red",
    "metrics",
    "prometheus"
  ],
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "npm run build",
    "clean": "rm -rf ./build && rm -rf ./resources",
    "build": "npm run clean && tsc && npm run copy-fragments && npm run generate-nodes && npm run bundle && npm run copy-files",
    "generate-nodes": "node build/GenerateNodes.js",
    "copy-fragments": "find src -name '*.html' -path '*/fragments/*' | while read f; do mkdir -p \"build/$(dirname \"${f#src/}\")\" && cp \"$f\" \"build/${f#src/}\"; done",
    "bundle": "node esbuild.js",
    "copy-files": "cp -r ./icons ./build 2>/dev/null || true && mkdir -p ./resources && cp -r ./build/resources/. ./resources/ 2>/dev/null || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theotherwillembotha/nodered_prometheus.git"
  },
  "files": ["build/", "icons/", "documentation/", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "nodered": ">=4.0.0"
  },
  "dependencies": {
    "@theotherwillembotha/node-red-plugincore": "^0.4.4"
  },
  "devDependencies": {
    "@theotherwillembotha/node-red-plugincore": "../nodered_plugincore",
    "@types/node": "^26.1.1",
    "@types/node-red": "~1.3.5",
    "esbuild": "^0.24.0",
    "prom-client": "^15.1.3",
    "typescript": "^5.8.3"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "prometheus": "./build/Nodes.js"
    },
    "plugins": {
      "prometheus": "./build/Plugins.js"
    }
  }
}
